# From @BotFather
BOT_TOKEN=

# Your numeric Telegram user ID (e.g. from @userinfobot). Always allowed.
OWNER_ID=

# Optional: extra allowed user IDs, comma-separated
ALLOWED_USER_IDS=

# Local MongoDB (default shown)
MONGODB_URI=mongodb://127.0.0.1:27017/truetune

# Where files are stored while a job needs them (default shown)
TEMP_DIR=tmp

# Max non-finished jobs per user (default shown)
MAX_ACTIVE_JOBS_PER_USER=50

# MusicBrainz requires a User-Agent with a real contact
MUSICBRAINZ_CONTACT=you@example.com

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info